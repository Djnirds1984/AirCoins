# Supabase credentials for the AirCoins license system.
# Copy this file to .env and fill in real values from your Supabase project dashboard.
# Supabase project URL (used for licensing AND software updates)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase anon/public key (used for licensing)
SUPABASE_ANON_KEY=your_anon_key_here
# Supabase service role key (used for licensing AND update publishing)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GITHUB_TOKEN= (deprecated — updater now uses Supabase Storage)
