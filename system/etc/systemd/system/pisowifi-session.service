[Unit]
Description=AirCoins - Session Manager
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pisowifi-session-manager
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal
PIDFile=/var/run/pisowifi-session.pid

# Needs root for PID file management
NoNewPrivileges=no
ProtectSystem=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
