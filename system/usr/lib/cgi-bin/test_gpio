#!/bin/bash
# ============================================
# AirCoins - GPIO Pin Test CGI Handler
# ============================================
# Reads the real state of a GPIO pin using board-aware methods
# Called from admin panel "Test Pin" button
#
# Install to: /usr/lib/cgi-bin/test_gpio
# Requires: lighttpd mod_cgi enabled
# ============================================

# Source the shared GPIO library
source /usr/local/bin/aircoins-gpio-lib

CONFIG_FILE="/var/lib/pisowifi/gpio_config"

# Load config to get current pin
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Re-detect board (config may override BOARD_MODEL)
detect_board
get_gpio_method

# Read POST body for pin override
read -r POST_DATA

# If POST data contains a pin, use it; otherwise use configured pin
if [ -n "$POST_DATA" ]; then
    PIN=$(echo "$POST_DATA" | grep -o '"pin":[0-9]*' | cut -d: -f2)
fi
PIN=${PIN:-$COIN_PULSE_PIN}
PIN=${PIN:-7}

# Convert physical pin to internal GPIO number
INTERNAL_GPIO=$(pin_to_gpio "$PIN")
if [ $? -ne 0 ] || [ -z "$INTERNAL_GPIO" ]; then
    echo "Content-Type: application/json"
    echo ""
    echo "{\"status\":\"error\",\"message\":\"Invalid physical pin $PIN for board $BOARD_FAMILY/$BOARD_CHIPSET\"}"
    exit 0
fi

# ============================================
# Read pin state using shared library
# ============================================
if [ "$GPIO_METHOD" != "none" ]; then
    # Setup pin as input with pull-up
    gpio_setup_input "$INTERNAL_GPIO" "up"
    sleep 0.05

    # Read pin state
    PIN_STATE=$(gpio_read "$INTERNAL_GPIO")
    PIN_STATE=${PIN_STATE:-1}

    if [ "$PIN_STATE" = "0" ]; then
        STATE_TEXT="LOW (0)"
        STATE_COLOR="#ff4444"
    else
        STATE_TEXT="HIGH (1)"
        STATE_COLOR="#00ff88"
    fi

    echo "Content-Type: application/json"
    echo ""
    echo "{\"status\":\"ok\",\"method\":\"$GPIO_METHOD\",\"pin\":$PIN,\"gpio\":$INTERNAL_GPIO,\"state\":$PIN_STATE,\"state_text\":\"$STATE_TEXT\",\"state_color\":\"$STATE_COLOR\",\"pull_up\":\"enabled\",\"board_family\":\"$BOARD_FAMILY\",\"board_model\":\"$BOARD_MODEL\"}"
    exit 0
fi

# ============================================
# NO GPIO AVAILABLE
# ============================================
echo "Content-Type: application/json"
echo ""
echo "{\"status\":\"error\",\"message\":\"No GPIO interface available. Ensure WiringOP or raspi-gpio is installed.\"}"
