#!/bin/bash
# ============================================
# AirCoins PisoWiFi - GPIO Pin Test CGI Handler
# ============================================
# Reads the real state of a GPIO pin using WiringOP or sysfs
# Called from admin panel "Test Pin" button
#
# Install to: /usr/lib/cgi-bin/test_gpio
# Requires: lighttpd mod_cgi enabled
# ============================================

CONFIG_FILE="/var/lib/pisowifi/gpio_config"

# Load config to get current pin
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Read POST body for pin override
read -r POST_DATA

# If POST data contains a pin, use it; otherwise use configured pin
if [ -n "$POST_DATA" ]; then
    PIN=$(echo "$POST_DATA" | grep -o '"pin":[0-9]*' | cut -d: -f2)
fi
PIN=${PIN:-$COIN_PULSE_PIN}
PIN=${PIN:-7}

# ============================================
# METHOD 1: WiringOP (gpio command)
# ============================================
if command -v gpio &> /dev/null; then
    # Set pin to input with pull-up
    gpio mode $PIN up
    gpio mode $PIN input
    sleep 0.05

    # Read pin state
    PIN_STATE=$(gpio read $PIN)

    if [ "$PIN_STATE" = "0" ]; then
        STATE_TEXT="LOW (0)"
        STATE_COLOR="#ff4444"
    else
        STATE_TEXT="HIGH (1)"
        STATE_COLOR="#00ff88"
    fi

    echo "Content-Type: application/json"
    echo ""
    echo "{\"status\":\"ok\",\"method\":\"wiringop\",\"pin\":$PIN,\"state\":$PIN_STATE,\"state_text\":\"$STATE_TEXT\",\"state_color\":\"$STATE_COLOR\",\"pull_up\":\"enabled\"}"
    exit 0
fi

# ============================================
# METHOD 2: sysfs GPIO
# ============================================
if [ -d /sys/class/gpio ]; then
    # Map WiringPi pin to BCM GPIO (Orange Pi specific)
    # This is a simplified mapping - may need adjustment per board
    BCM_GPIO_MAP="6 1 2 3 6 7 8 9 10 13 14 11 12 21 18 19 20 16 15 0 1 3"
    BCM_GPIO=$(echo $BCM_GPIO_MAP | cut -d' ' -f$((PIN + 1)))
    BCM_GPIO=${BCM_GPIO:-6}

    # Export if not already
    echo "$BCM_GPIO" > /sys/class/gpio/export 2>/dev/null
    sleep 0.1
    echo "in" > /sys/class/gpio/gpio${BCM_GPIO}/direction 2>/dev/null

    PIN_STATE=$(cat /sys/class/gpio/gpio${BCM_GPIO}/value 2>/dev/null)
    PIN_STATE=${PIN_STATE:-1}

    if [ "$PIN_STATE" = "0" ]; then
        STATE_TEXT="LOW (0)"
        STATE_COLOR="#ff4444"
    else
        STATE_TEXT="HIGH (1)"
        STATE_COLOR="#00ff88"
    fi

    echo "Content-Type: application/json"
    echo ""
    echo "{\"status\":\"ok\",\"method\":\"sysfs\",\"pin\":$PIN,\"bcm_gpio\":$BCM_GPIO,\"state\":$PIN_STATE,\"state_text\":\"$STATE_TEXT\",\"state_color\":\"$STATE_COLOR\",\"pull_up\":\"enabled\"}"
    exit 0
fi

# ============================================
# NO GPIO AVAILABLE
# ============================================
echo "Content-Type: application/json"
echo ""
echo "{\"status\":\"error\",\"message\":\"No GPIO interface available. Ensure WiringOP is installed.\"}"
