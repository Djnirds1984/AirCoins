#!/bin/bash
# ============================================
# AirCoins - Captive Portal Rules
# ============================================
# Per-VLAN captive portal capture (DNS + HTTP
# redirect to the portal) plus NAT/forwarding
# for authorized (paying) clients.
#
# Install to: /usr/local/bin/aircoins-captive-rules
#
# Usage:
#   aircoins-captive-rules add    <iface> <gateway> [anti_hotspot]
#   aircoins-captive-rules del    <iface> <gateway> [anti_hotspot]
#   aircoins-captive-rules auth   <mac>
#   aircoins-captive-rules unauth <mac>
#   aircoins-captive-rules status
#
# Rule layout (both chains are shared by all VLANs):
#
#   nat AIRCOINS_CAPTIVE   (hooked first in nat PREROUTING)
#     [top]  authorized clients: DNS -> real upstream, then RETURN
#     [tail] per-VLAN: DNS -> gateway dnsmasq, HTTP -> gateway portal
#
#   filter AIRCOINS_FORWARD  (hooked first in filter FORWARD)
#     [top]  authorized clients: ACCEPT
#     [tail] per-VLAN: return traffic ACCEPT, everything else DROP
#
# Authorized-client rules always sit ABOVE the captive
# rules, so paying clients bypass the portal capture.
# ============================================

set -u

# ============================================
# CONFIGURATION
# ============================================
# Upstream resolver handed to authorized clients (their port 53
# traffic is DNAT'ed here, bypassing the wildcard portal hijack).
UPSTREAM_DNS="8.8.8.8"

# Leave empty to auto-detect the uplink from the default route.
WAN_IFACE=""

CAPTIVE_CONF="/etc/pisowifi/captive.conf"
# shellcheck source=/dev/null
[ -f "$CAPTIVE_CONF" ] && source "$CAPTIVE_CONF"

NAT_CHAIN="AIRCOINS_CAPTIVE"
FWD_CHAIN="AIRCOINS_FORWARD"
STATE_DIR="/var/lib/pisowifi/captive"

# ============================================
# LOGGING
# ============================================
log() {
    logger -t aircoins-captive "$1" 2>/dev/null
    echo "$1"
}

die() {
    echo "ERROR: $1" >&2
    exit 1
}

# ============================================
# VALIDATION
# ============================================
valid_iface() {
    case "$1" in
        ""|lo|*/*|*..*) return 1 ;;
    esac
    [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

valid_ip() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    local IFS=. octet
    for octet in $1; do
        [ "$octet" -le 255 ] || return 1
    done
    return 0
}

valid_mac() {
    [[ "$1" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]
}

# ============================================
# IDEMPOTENT iptables HELPERS
# ============================================
# All mutations check with -C first so repeated calls are safe.

# ensure_chain <table> <chain>
ensure_chain() {
    iptables -t "$1" -S "$2" >/dev/null 2>&1 || iptables -t "$1" -N "$2"
}

# ensure_hook <table> <parent-chain> <target-chain>
# Hooks target as the FIRST rule of the parent chain.
ensure_hook() {
    if ! iptables -t "$1" -C "$2" -j "$3" 2>/dev/null; then
        iptables -t "$1" -I "$2" 1 -j "$3"
    fi
}

# append_rule <table> <chain> <rule...>
append_rule() {
    local table="$1"; shift
    if ! iptables -t "$table" -C "$@" 2>/dev/null; then
        iptables -t "$table" -A "$@"
    fi
}

# insert_rule <table> <chain> <rule...>  (at position 1)
insert_rule() {
    local table="$1" chain="$2"; shift 2
    if ! iptables -t "$table" -C "$chain" "$@" 2>/dev/null; then
        iptables -t "$table" -I "$chain" 1 "$@"
    fi
}

# delete_rule <table> <chain> <rule...>  (removes every duplicate)
delete_rule() {
    local table="$1"; shift
    while iptables -t "$table" -C "$@" 2>/dev/null; do
        iptables -t "$table" -D "$@" 2>/dev/null || break
    done
}

# ============================================
# NETWORK HELPERS
# ============================================
detect_wan() {
    if [ -n "$WAN_IFACE" ]; then
        echo "$WAN_IFACE"
        return
    fi
    ip route show default 2>/dev/null |
        awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}'
}

# iface_cidr <iface> -> "10.0.22.1/24"
iface_cidr() {
    ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4; exit}'
}

# cidr_to_network <ip/prefix> -> "10.0.22.0/24"
cidr_to_network() {
    local ipcidr="$1" ip prefix
    ip="${ipcidr%%/*}"
    prefix="${ipcidr#*/}"
    if [ "$prefix" = "$ipcidr" ] || [ -z "$prefix" ]; then
        prefix=24
    fi
    [ "$prefix" -ge 0 ] 2>/dev/null && [ "$prefix" -le 32 ] || prefix=24
    valid_ip "$ip" || return 1

    local IFS=. o1 o2 o3 o4
    read -r o1 o2 o3 o4 <<< "$ip"
    local value=$(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 ))
    local mask=0
    if [ "$prefix" -gt 0 ]; then
        mask=$(( (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
    fi
    local net=$(( value & mask ))
    echo "$(( (net >> 24) & 255 )).$(( (net >> 16) & 255 )).$(( (net >> 8) & 255 )).$(( net & 255 ))/$prefix"
}

# Resolve the subnet for an iface, remembering it so `del` still
# works after the VLAN interface has already been torn down.
subnet_for() {
    local iface="$1" cidr subnet
    mkdir -p "$STATE_DIR" 2>/dev/null
    local cache="$STATE_DIR/${iface}.subnet"

    cidr=$(iface_cidr "$iface")
    if [ -n "$cidr" ]; then
        subnet=$(cidr_to_network "$cidr") && [ -n "$subnet" ] && {
            echo "$subnet" > "$cache" 2>/dev/null
            echo "$subnet"
            return 0
        }
    fi

    if [ -f "$cache" ]; then
        cat "$cache"
        return 0
    fi
    return 1
}

enable_forwarding() {
    if [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" != "1" ]; then
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    fi
}

# NOTE: Anti-hotspot (TTL=1) is handled entirely by the Go API binary
# via direct iptables mangle commands. This script does NOT touch the
# mangle table or anti-hotspot state. This avoids conflicts between
# the shell script and the Go binary.

# ============================================
# CAPTIVE RULES - ADD
# ============================================
cmd_add() {
    local iface="$1" gateway="$2"
    valid_iface "$iface" || die "invalid interface: $iface"
    valid_ip "$gateway" || die "invalid gateway: $gateway"

    enable_forwarding
    ensure_chain nat "$NAT_CHAIN"
    ensure_chain filter "$FWD_CHAIN"
    ensure_hook nat PREROUTING "$NAT_CHAIN"
    ensure_hook filter FORWARD "$FWD_CHAIN"

    # --- Capture: send all DNS to the local dnsmasq for this VLAN.
    append_rule nat "$NAT_CHAIN" -i "$iface" -p udp --dport 53 \
        -j DNAT --to-destination "$gateway:53"
    append_rule nat "$NAT_CHAIN" -i "$iface" -p tcp --dport 53 \
        -j DNAT --to-destination "$gateway:53"

    # --- Capture: force all HTTP to the portal.
    append_rule nat "$NAT_CHAIN" -i "$iface" -p tcp --dport 80 \
        -j DNAT --to-destination "$gateway:80"

    # --- Portal/DHCP/DNS access to the gateway itself.
    append_rule filter INPUT -i "$iface" -p udp --dport 67:68 -j ACCEPT
    append_rule filter INPUT -i "$iface" -p udp --dport 53 -j ACCEPT
    append_rule filter INPUT -i "$iface" -p tcp --dport 53 -j ACCEPT
    append_rule filter INPUT -i "$iface" -p tcp --dport 80 -j ACCEPT

    # --- Forwarding: return traffic is fine, anything else from an
    # unauthorized client is dropped (authorized MACs ACCEPT above).
    append_rule filter "$FWD_CHAIN" -o "$iface" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    append_rule filter "$FWD_CHAIN" -i "$iface" -j DROP

    # --- NAT for authorized clients reaching the internet.
    local subnet wan
    subnet=$(subnet_for "$iface")
    wan=$(detect_wan)
    if [ -n "$subnet" ] && [ -n "$wan" ] && [ "$wan" != "$iface" ]; then
        append_rule nat POSTROUTING -s "$subnet" -o "$wan" -j MASQUERADE
        log "captive rules added for $iface (gw $gateway, nat $subnet -> $wan)"
    else
        log "captive rules added for $iface (gw $gateway, MASQUERADE skipped: no uplink)"
    fi
}

# ============================================
# CAPTIVE RULES - DEL
# ============================================
cmd_del() {
    local iface="$1" gateway="$2"
    valid_iface "$iface" || die "invalid interface: $iface"
    valid_ip "$gateway" || die "invalid gateway: $gateway"

    local subnet wan
    subnet=$(subnet_for "$iface")
    wan=$(detect_wan)
    if [ -n "$subnet" ] && [ -n "$wan" ]; then
        delete_rule nat POSTROUTING -s "$subnet" -o "$wan" -j MASQUERADE
    fi

    delete_rule nat "$NAT_CHAIN" -i "$iface" -p udp --dport 53 \
        -j DNAT --to-destination "$gateway:53"
    delete_rule nat "$NAT_CHAIN" -i "$iface" -p tcp --dport 53 \
        -j DNAT --to-destination "$gateway:53"
    delete_rule nat "$NAT_CHAIN" -i "$iface" -p tcp --dport 80 \
        -j DNAT --to-destination "$gateway:80"

    delete_rule filter INPUT -i "$iface" -p udp --dport 67:68 -j ACCEPT
    delete_rule filter INPUT -i "$iface" -p udp --dport 53 -j ACCEPT
    delete_rule filter INPUT -i "$iface" -p tcp --dport 53 -j ACCEPT
    delete_rule filter INPUT -i "$iface" -p tcp --dport 80 -j ACCEPT

    delete_rule filter "$FWD_CHAIN" -o "$iface" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    delete_rule filter "$FWD_CHAIN" -i "$iface" -j DROP

    rm -f "$STATE_DIR/${iface}.subnet" 2>/dev/null

    log "captive rules removed for $iface"
}

# ============================================
# CLIENT AUTHORIZATION
# ============================================
# Drop the conntrack entries for one client only, so a state change takes
# effect immediately instead of riding already-established (and already
# DNAT'ed) connections. Scoped by the client's current IP from the neighbour
# table — never flush the whole table, that would cut off every other client.
flush_client_conntrack() {
    local mac="$1" ip
    command -v conntrack >/dev/null 2>&1 || return 0

    for ip in $(ip neigh show 2>/dev/null |
        awk -v m="$mac" 'tolower($0) ~ tolower(m) {print $1}'); do
        valid_ip "$ip" || continue
        conntrack -D --src "$ip" >/dev/null 2>&1
        conntrack -D --dst "$ip" >/dev/null 2>&1
    done
    return 0
}

# Removes the whitelist rules for a MAC (used by both unauth and
# auth, so re-authorizing cannot leave rules in the wrong order).
remove_auth_rules() {
    local mac="$1"
    delete_rule nat "$NAT_CHAIN" -p udp --dport 53 -m mac --mac-source "$mac" \
        -j DNAT --to-destination "$UPSTREAM_DNS:53"
    delete_rule nat "$NAT_CHAIN" -p tcp --dport 53 -m mac --mac-source "$mac" \
        -j DNAT --to-destination "$UPSTREAM_DNS:53"
    delete_rule nat "$NAT_CHAIN" -m mac --mac-source "$mac" -j RETURN
    delete_rule filter "$FWD_CHAIN" -m mac --mac-source "$mac" -j ACCEPT
}

cmd_auth() {
    local mac="$1"
    valid_mac "$mac" || die "invalid MAC address: $mac"

    ensure_chain nat "$NAT_CHAIN"
    ensure_chain filter "$FWD_CHAIN"
    ensure_hook nat PREROUTING "$NAT_CHAIN"
    ensure_hook filter FORWARD "$FWD_CHAIN"
    enable_forwarding

    # Rebuild from scratch so the rules land in a known order.
    remove_auth_rules "$mac"

    # Inserted at position 1 each time, so the resulting top-down
    # order is: udp/53 -> upstream, tcp/53 -> upstream, RETURN.
    insert_rule nat "$NAT_CHAIN" -m mac --mac-source "$mac" -j RETURN
    insert_rule nat "$NAT_CHAIN" -p tcp --dport 53 -m mac --mac-source "$mac" \
        -j DNAT --to-destination "$UPSTREAM_DNS:53"
    insert_rule nat "$NAT_CHAIN" -p udp --dport 53 -m mac --mac-source "$mac" \
        -j DNAT --to-destination "$UPSTREAM_DNS:53"

    insert_rule filter "$FWD_CHAIN" -m mac --mac-source "$mac" -j ACCEPT

    # Existing connections were DNAT'ed to the portal; clear them so the
    # client gets real internet right away.
    flush_client_conntrack "$mac"

    log "client authorized: $mac (dns -> $UPSTREAM_DNS)"
}

cmd_unauth() {
    local mac="$1"
    valid_mac "$mac" || die "invalid MAC address: $mac"

    remove_auth_rules "$mac"

    # Clear the client's established connections so it is captured by the
    # portal again immediately.
    flush_client_conntrack "$mac"

    log "client deauthorized: $mac"
}

# ============================================
# STATUS
# ============================================
cmd_status() {
    echo "--- nat $NAT_CHAIN ---"
    iptables -t nat -S "$NAT_CHAIN" 2>/dev/null || echo "  (chain not present)"
    echo ""
    echo "--- filter $FWD_CHAIN ---"
    iptables -S "$FWD_CHAIN" 2>/dev/null || echo "  (chain not present)"
    echo ""
    echo "--- mangle AIRCOINS_TTL (anti-hotspot, managed by Go API) ---"
    iptables -t mangle -S AIRCOINS_TTL 2>/dev/null || echo "  (chain not present)"
    echo ""
    echo "--- nat POSTROUTING (MASQUERADE) ---"
    iptables -t nat -S POSTROUTING 2>/dev/null | grep MASQUERADE || echo "  (none)"
    echo ""
    echo "uplink:       $(detect_wan)"
    echo "upstream dns: $UPSTREAM_DNS"
    echo "ip_forward:   $(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"
}

usage() {
    cat <<'EOF'
AirCoins Captive Portal Rules

Usage:
  aircoins-captive-rules add    <iface> <gateway>   Capture unauthenticated clients on a VLAN
  aircoins-captive-rules del    <iface> <gateway>   Remove the capture rules for a VLAN
  aircoins-captive-rules auth   <mac>               Whitelist a paying client (internet + real DNS)
  aircoins-captive-rules unauth <mac>               Revoke a client's access
  aircoins-captive-rules status                     Show current rules

Note: Anti-hotspot (TTL=1) is managed by the Go API binary directly.

Examples:
  aircoins-captive-rules add end0.22 10.0.22.1
  aircoins-captive-rules auth aa:bb:cc:dd:ee:ff
EOF
}

# ============================================
# MAIN
# ============================================
if [ "$(id -u)" -ne 0 ]; then
    die "must be run as root"
fi

if ! command -v iptables >/dev/null 2>&1; then
    die "iptables not found"
fi

case "${1:-}" in
    add)
        [ $# -ge 3 ] && [ $# -le 4 ] || { usage; exit 1; }
        cmd_add "$2" "$3"
        ;;
    del)
        [ $# -ge 3 ] && [ $# -le 4 ] || { usage; exit 1; }
        cmd_del "$2" "$3"
        ;;
    auth)
        [ $# -eq 2 ] || { usage; exit 1; }
        cmd_auth "$2"
        ;;
    unauth)
        [ $# -eq 2 ] || { usage; exit 1; }
        cmd_unauth "$2"
        ;;
    status)
        cmd_status
        ;;
    *)
        usage
        exit 1
        ;;
esac
