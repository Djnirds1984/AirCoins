#!/bin/bash
# ============================================
# AirCoins GPIO Library — board-aware GPIO abstraction
# ============================================
# Source this file: source /usr/local/bin/aircoins-gpio-lib
#
# Provides: detect_board, get_gpio_method, pin_to_gpio,
#           gpio_read, gpio_setup_input, get_available_pins, get_pin_labels
# ============================================

# Guard against double-sourcing
if [ -n "$_AIRCOINS_GPIO_LIB_LOADED" ]; then
    return 0 2>/dev/null || true
fi
_AIRCOINS_GPIO_LIB_LOADED=1

# Global variables set by detect_board / get_gpio_method
BOARD_FAMILY=""
BOARD_MODEL=""
BOARD_CHIPSET=""
GPIO_PIN_COUNT=0
GPIO_METHOD=""

CONFIG_FILE="/var/lib/pisowifi/gpio_config"

# ============================================
# Board Detection
# ============================================
detect_board() {
    local model_raw=""

    # Check if config file has a manual override
    if [ -f "$CONFIG_FILE" ]; then
        local cfg_board=""
        cfg_board=$(grep -E '^BOARD_MODEL=' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'")
        if [ -n "$cfg_board" ] && [ "$cfg_board" != "auto" ]; then
            model_raw="$cfg_board"
        fi
    fi

    # Read from device-tree if no override
    if [ -z "$model_raw" ]; then
        if [ -f /proc/device-tree/model ]; then
            model_raw=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        fi
    fi

    # Fallback: /etc/armbian-release
    if [ -z "$model_raw" ] && [ -f /etc/armbian-release ]; then
        model_raw=$(grep '^BOARD_NAME=' /etc/armbian-release 2>/dev/null | cut -d= -f2 | tr -d '"')
    fi

    # Fallback: /proc/cpuinfo Hardware line
    if [ -z "$model_raw" ] && [ -f /proc/cpuinfo ]; then
        model_raw=$(grep -m1 '^Hardware' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[[:space:]]*//')
    fi

    BOARD_MODEL="${model_raw:-Unknown}"

    # Determine family and chipset
    local model_lower
    model_lower=$(echo "$BOARD_MODEL" | tr '[:upper:]' '[:lower:]')

    if echo "$model_lower" | grep -qi "orange.pi\|orangepi"; then
        BOARD_FAMILY="orangepi"
        # Detect chipset
        if echo "$model_lower" | grep -qi "zero.*2\|zero2"; then
            BOARD_CHIPSET="H616"
            GPIO_PIN_COUNT=26
        elif echo "$model_lower" | grep -qi "5.*plus\|5plus"; then
            BOARD_CHIPSET="RK3588"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi " 5\|5 "; then
            BOARD_CHIPSET="RK3588"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "zero.*plus\|zeroplus"; then
            BOARD_CHIPSET="H5"
            GPIO_PIN_COUNT=26
        elif echo "$model_lower" | grep -qi "zero"; then
            BOARD_CHIPSET="H2+"
            GPIO_PIN_COUNT=26
        elif echo "$model_lower" | grep -qi "plus.2e\|plus2e"; then
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "pc.plus\|pcplus"; then
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "pc"; then
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "lite"; then
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "one"; then
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        else
            BOARD_CHIPSET="H3"
            GPIO_PIN_COUNT=40
        fi
    elif echo "$model_lower" | grep -qi "raspberry.pi\|raspberrypi"; then
        BOARD_FAMILY="raspberrypi"
        if echo "$model_lower" | grep -qi " 5\|5 "; then
            BOARD_CHIPSET="BCM2712"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi " 4\|4 "; then
            BOARD_CHIPSET="BCM2711"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi " 3\|3 "; then
            BOARD_CHIPSET="BCM2837"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi " 2\|2 "; then
            BOARD_CHIPSET="BCM2836"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "zero.*2\|zero2"; then
            BOARD_CHIPSET="BCM2710A1"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi "zero"; then
            BOARD_CHIPSET="BCM2835"
            GPIO_PIN_COUNT=40
        elif echo "$model_lower" | grep -qi " 1\|model b"; then
            BOARD_CHIPSET="BCM2835"
            GPIO_PIN_COUNT=26
        else
            BOARD_CHIPSET="BCM2711"
            GPIO_PIN_COUNT=40
        fi
    else
        BOARD_FAMILY="unknown"
        BOARD_CHIPSET="unknown"
        GPIO_PIN_COUNT=40
    fi
}

# ============================================
# GPIO Method Detection
# ============================================
get_gpio_method() {
    if [ "$BOARD_FAMILY" = "orangepi" ] && command -v gpio &>/dev/null; then
        GPIO_METHOD="wiringop"
    elif [ "$BOARD_FAMILY" = "raspberrypi" ] && command -v raspi-gpio &>/dev/null; then
        GPIO_METHOD="raspi-gpio"
    elif [ "$BOARD_FAMILY" = "raspberrypi" ] && command -v pinctrl &>/dev/null; then
        GPIO_METHOD="raspi-gpio"
    elif command -v gpioget &>/dev/null; then
        GPIO_METHOD="libgpiod"
    elif [ -d /sys/class/gpio ]; then
        GPIO_METHOD="sysfs"
    else
        GPIO_METHOD="none"
    fi
}

# ============================================
# Pin Translation: physical pin -> internal GPIO number
# ============================================
pin_to_gpio() {
    local pin=$1

    if [ "$BOARD_FAMILY" = "orangepi" ]; then
        # Orange Pi H3/H5/H6 40-pin header (physical pin -> PA GPIO number)
        # Also works for H2+ (26-pin subset)
        case "$pin" in
            3)  echo 12 ;;   # PA12
            5)  echo 11 ;;   # PA11
            7)  echo 6 ;;    # PA6
            8)  echo 13 ;;   # PA13
            10) echo 14 ;;   # PA14
            11) echo 1 ;;    # PA1
            12) echo 358 ;;  # PD14 (14*32+14=358 on some mappings, but WiringOP uses different)
            13) echo 0 ;;    # PA0
            15) echo 3 ;;    # PA3
            16) echo 68 ;;   # PC4
            18) echo 71 ;;   # PC7
            19) echo 64 ;;   # PC0
            21) echo 65 ;;   # PC1
            22) echo 2 ;;    # PA2
            23) echo 66 ;;   # PC2
            24) echo 67 ;;   # PC3
            26) echo 21 ;;   # PA21
            27) echo 19 ;;   # PA19
            28) echo 18 ;;   # PA18
            29) echo 7 ;;    # PA7
            31) echo 8 ;;    # PA8
            32) echo 200 ;;  # PG8
            33) echo 201 ;;  # PG9
            35) echo 198 ;;  # PG6
            36) echo 199 ;;  # PG7
            37) echo 9 ;;    # PA9
            38) echo 10 ;;   # PA10
            40) echo 17 ;;   # PA17
            *)  return 1 ;;
        esac
    elif [ "$BOARD_FAMILY" = "raspberrypi" ]; then
        # Raspberry Pi BCM mapping (physical pin -> BCM GPIO)
        case "$pin" in
            3)  echo 2 ;;
            5)  echo 3 ;;
            7)  echo 4 ;;
            8)  echo 14 ;;
            10) echo 15 ;;
            11) echo 17 ;;
            12) echo 18 ;;
            13) echo 27 ;;
            15) echo 22 ;;
            16) echo 23 ;;
            18) echo 24 ;;
            19) echo 10 ;;
            21) echo 9 ;;
            22) echo 25 ;;
            23) echo 11 ;;
            24) echo 8 ;;
            26) echo 7 ;;
            29) echo 5 ;;
            31) echo 6 ;;
            32) echo 12 ;;
            33) echo 13 ;;
            35) echo 19 ;;
            36) echo 16 ;;
            37) echo 26 ;;
            38) echo 20 ;;
            40) echo 21 ;;
            *)  return 1 ;;
        esac
    else
        # Unknown board — try sysfs directly with pin as GPIO number
        echo "$pin"
    fi
}

# ============================================
# GPIO Operations
# ============================================
gpio_read() {
    local gpio_num=$1

    case "$GPIO_METHOD" in
        wiringop)
            gpio read "$gpio_num" 2>/dev/null
            ;;
        raspi-gpio)
            raspi-gpio get "$gpio_num" 2>/dev/null | grep -oP 'level=\K[01]'
            ;;
        libgpiod)
            gpioget gpiochip0 "$gpio_num" 2>/dev/null
            ;;
        sysfs)
            # Export if needed
            if [ ! -d "/sys/class/gpio/gpio${gpio_num}" ]; then
                echo "$gpio_num" > /sys/class/gpio/export 2>/dev/null
                sleep 0.1
                echo "in" > "/sys/class/gpio/gpio${gpio_num}/direction" 2>/dev/null
            fi
            cat "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null
            ;;
        *)
            echo "1"
            ;;
    esac
}

gpio_setup_input() {
    local gpio_num=$1
    local pull=${2:-up}

    case "$GPIO_METHOD" in
        wiringop)
            gpio mode "$gpio_num" in 2>/dev/null
            if [ "$pull" = "up" ]; then
                gpio -g mode "$gpio_num" up 2>/dev/null
            elif [ "$pull" = "down" ]; then
                gpio -g mode "$gpio_num" down 2>/dev/null
            fi
            ;;
        raspi-gpio)
            if [ "$pull" = "up" ]; then
                raspi-gpio set "$gpio_num" ip pu 2>/dev/null
            elif [ "$pull" = "down" ]; then
                raspi-gpio set "$gpio_num" ip pd 2>/dev/null
            else
                raspi-gpio set "$gpio_num" ip 2>/dev/null
            fi
            ;;
        libgpiod)
            # libgpiod doesn't have persistent pull-up via CLI; reading works with gpioget
            true
            ;;
        sysfs)
            if [ ! -d "/sys/class/gpio/gpio${gpio_num}" ]; then
                echo "$gpio_num" > /sys/class/gpio/export 2>/dev/null
                sleep 0.1
            fi
            echo "in" > "/sys/class/gpio/gpio${gpio_num}/direction" 2>/dev/null
            ;;
    esac
}

# ============================================
# Pin Listing
# ============================================
get_available_pins() {
    if [ "$GPIO_PIN_COUNT" -eq 26 ]; then
        echo "3 5 7 8 10 11 12 13 15 16 18 19 21 22 23 24 26"
    else
        echo "3 5 7 8 10 11 12 13 15 16 18 19 21 22 23 24 26 29 31 32 33 35 36 37 38 40"
    fi
}

get_pin_labels() {
    # Outputs JSON array of {pin, gpio, label} for the current board
    local pins
    pins=$(get_available_pins)

    local first=1
    echo -n "["
    for p in $pins; do
        local gpio_num
        gpio_num=$(pin_to_gpio "$p") || continue

        local label=""
        if [ "$BOARD_FAMILY" = "orangepi" ]; then
            # Build PA/PD/PC/PG label from GPIO number
            case "$p" in
                3)  label="PA12" ;; 5)  label="PA11" ;; 7)  label="PA6" ;;
                8)  label="PA13" ;; 10) label="PA14" ;; 11) label="PA1" ;;
                12) label="PD14" ;; 13) label="PA0" ;; 15) label="PA3" ;;
                16) label="PC4" ;; 18) label="PC7" ;; 19) label="PC0" ;;
                21) label="PC1" ;; 22) label="PA2" ;; 23) label="PC2" ;;
                24) label="PC3" ;; 26) label="PA21" ;; 27) label="PA19" ;;
                28) label="PA18" ;; 29) label="PA7" ;; 31) label="PA8" ;;
                32) label="PG8" ;; 33) label="PG9" ;; 35) label="PG6" ;;
                36) label="PG7" ;; 37) label="PA9" ;; 38) label="PA10" ;;
                40) label="PA17" ;; *) label="GPIO$gpio_num" ;;
            esac
        elif [ "$BOARD_FAMILY" = "raspberrypi" ]; then
            label="GPIO$gpio_num"
        else
            label="GPIO$gpio_num"
        fi

        if [ $first -eq 1 ]; then
            first=0
        else
            echo -n ","
        fi
        echo -n "{\"pin\":$p,\"gpio\":$gpio_num,\"label\":\"$label\"}"
    done
    echo "]"
}

# ============================================
# Auto-detect on source if not already set
# ============================================
if [ -z "$BOARD_FAMILY" ]; then
    detect_board
    get_gpio_method
fi
