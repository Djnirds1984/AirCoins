#!/bin/bash
# AirCoins VLAN Restore — applies saved VLAN config on boot
CONF="/etc/pisowifi/vlans.conf"
[ -f "$CONF" ] || exit 0

# Load 8021q kernel module
modprobe 8021q 2>/dev/null
sleep 1

# Function: wait for interface to be UP
wait_for_iface() {
    local iface=$1
    local max_wait=30
    local waited=0
    while [ $waited -lt $max_wait ]; do
        if ip link show "$iface" 2>/dev/null | grep -q "state UP"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    logger -t aircoins-vlan "Timeout waiting for $iface to come up"
    return 1
}

while IFS= read -r line; do
    # Skip comments and empty lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue

    # Parse: interface vlan_id ip/cidr description [portal]
    parent=$(echo "$line" | awk '{print $1}')
    vid=$(echo "$line" | awk '{print $2}')
    cidr=$(echo "$line" | awk '{print $3}')

    # Skip if any required field is missing
    if [ -z "$parent" ] || [ -z "$vid" ] || [ -z "$cidr" ]; then
        continue
    fi

    name="${parent}.${vid}"

    # Wait for parent interface
    if ! wait_for_iface "$parent"; then
        logger -t aircoins-vlan "Skipping $name — parent $parent not ready"
        continue
    fi

    # Create VLAN interface if not exists
    if ! ip link show "$name" &>/dev/null; then
        ip link add link "$parent" name "$name" type vlan id "$vid" 2>/dev/null
        if [ $? -ne 0 ]; then
            logger -t aircoins-vlan "Failed to create $name"
            continue
        fi
        logger -t aircoins-vlan "Created VLAN $name"
    fi

    # Bring up first
    ip link set "$name" up 2>/dev/null
    sleep 1

    # Assign IP (remove first to handle stale state, then add fresh)
    ip addr flush dev "$name" scope global 2>/dev/null
    ip addr add "$cidr" dev "$name" 2>/dev/null

    # Verify IP was assigned
    if ! ip addr show "$name" 2>/dev/null | grep -q "inet ${cidr%/*}"; then
        sleep 1
        ip addr add "$cidr" dev "$name" 2>/dev/null
    fi

    # Wait for VLAN interface to be UP
    if ! ip link show "$name" 2>/dev/null | grep -q "state UP"; then
        ip link set "$name" up 2>/dev/null
        sleep 1
    fi

    logger -t aircoins-vlan "Restored VLAN $name ($cidr)"

    # Start DHCP
    if [ -f "/etc/dnsmasq.d/${name}.conf" ]; then
        systemctl restart "dnsmasq@${name}" 2>/dev/null
        if [ $? -ne 0 ]; then
            sleep 2
            systemctl restart "dnsmasq@${name}" 2>/dev/null
        fi
        logger -t aircoins-vlan "Started DHCP for $name"
    fi

    # Apply captive portal rules (DNS/HTTP capture + NAT for paid clients)
    if [ -x /usr/local/bin/aircoins-captive-rules ]; then
        /usr/local/bin/aircoins-captive-rules add "$name" "${cidr%/*}" >/dev/null 2>&1 ||
            logger -t aircoins-vlan "Failed to apply captive rules for $name"
    fi

done < "$CONF"

logger -t aircoins-vlan "VLAN restore complete"
