#!/bin/bash
# ============================================
# AirCoins - GPIO Coin Listener Daemon
# ============================================
# Listens for coin pulses on GPIO pin
# Supports Orange Pi (WiringOP), Raspberry Pi (raspi-gpio),
# libgpiod, and sysfs fallbacks.
#
# Install to: /usr/local/bin/gpio-coin-listener
# Runs as: systemd service
#
# GPIO PIN CONFIGURATION:
#   Configurable via Admin Panel or /var/lib/pisowifi/gpio_config
#   Default: Physical pin 7
#   Connect coin acceptor pulse wire to selected GPIO pin
#   Connect coin acceptor GND to board GND
#
# HOW IT WORKS (on-demand arm/disarm):
#   1. Listener idles (1s file stat, no GPIO reads, ~0% CPU)
#   2. Customer taps "Insert Coin" on the portal -> API writes
#      /run/pisowifi/coinslot.armed (epoch when arming expires)
#   3. Listener switches to ARMED and polls GPIO for coin pulses
#   4. Coin pulse detected -> event posted to API, armed window
#      extended by +30s (multi-coin insertion isn't cut off)
#   5. Armed file gone/expired -> back to IDLE
# ============================================

# Source the shared GPIO library
GPIO_LIB="/usr/local/bin/aircoins-gpio-lib"
if [ -f "$GPIO_LIB" ]; then
    source "$GPIO_LIB"
else
    echo "ERROR: GPIO library not found at $GPIO_LIB" >&2
    exit 1
fi

# ============================================
# CONFIGURATION
# ============================================
# Default values (overridden by config file)
COIN_PULSE_PIN=7                    # Physical pin number
COIN_VALUE=1                        # Peso value per pulse
PULSE_MODE="falling"                # falling, rising, or both

# Config file (written by admin panel / API)
CONFIG_FILE="/var/lib/pisowifi/gpio_config"

# Load config from file if exists
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Re-detect board after loading config (config may override BOARD_MODEL)
detect_board
get_gpio_method

EVENT_FILE="/var/lib/pisowifi/coin_event"
LOG_FILE="/var/log/pisowifi/gpio-coin.log"
PID_FILE="/var/run/gpio-coin-listener.pid"
STATE_FILE="/var/lib/pisowifi/gpio_state"
ARMED_FILE="/run/pisowifi/coinslot.armed"   # written by API (POST /api/coinslot/arm)
ARM_EXTEND_SEC=30                            # extra window per detected coin

# ============================================
# LOGGING
# ============================================
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# ============================================
# CLEANUP ON EXIT
# ============================================
cleanup() {
    log "GPIO Coin Listener stopping..."
    # Unexport GPIO if using sysfs
    if [ "$GPIO_METHOD" = "sysfs" ] && [ -n "$INTERNAL_GPIO" ]; then
        echo "$INTERNAL_GPIO" > /sys/class/gpio/unexport 2>/dev/null
    fi
    rm -f "$PID_FILE" "$ARMED_FILE"
    exit 0
}

trap cleanup SIGTERM SIGINT EXIT

# ============================================
# WRITE PID
# ============================================
echo $$ > "$PID_FILE"

# Remove stale armed file from a previous run (/run is tmpfs, but be safe)
rm -f "$ARMED_FILE"

log "GPIO Coin Listener started (PID: $$)"
log "Board: $BOARD_FAMILY / $BOARD_MODEL ($BOARD_CHIPSET)"
log "GPIO method: $GPIO_METHOD"
log "Listening on physical pin: $COIN_PULSE_PIN"
log "Coin value per pulse: P$COIN_VALUE"

# ============================================
# Convert physical pin to internal GPIO number
# ============================================
INTERNAL_GPIO=$(pin_to_gpio "$COIN_PULSE_PIN")
if [ $? -ne 0 ] || [ -z "$INTERNAL_GPIO" ]; then
    log "ERROR: Invalid physical pin $COIN_PULSE_PIN for board $BOARD_FAMILY/$BOARD_CHIPSET"
    exit 1
fi
log "Internal GPIO number: $INTERNAL_GPIO"

# ============================================
# ARM/DISARM HELPERS
# ============================================
# coinslot_armed: returns 0 while the armed window is open.
# Removes the armed file when it is expired or corrupt.
coinslot_armed() {
    [ -f "$ARMED_FILE" ] || return 1

    local expires
    expires=$(cat "$ARMED_FILE" 2>/dev/null | tr -d '[:space:]')

    # Must be a plain number (epoch seconds)
    case "$expires" in
        ''|*[!0-9]*)
            rm -f "$ARMED_FILE"
            return 1
            ;;
    esac

    if [ "$(date +%s)" -ge "$expires" ]; then
        rm -f "$ARMED_FILE"
        return 1
    fi

    return 0
}

# extend_armed_window: push expiry +ARM_EXTEND_SEC so multi-coin
# insertion isn't cut off mid-payment
extend_armed_window() {
    echo $(( $(date +%s) + ARM_EXTEND_SEC )) > "$ARMED_FILE"
}

# handle_coin_pulse: log, post event to API, extend window, debounce
handle_coin_pulse() {
    COIN_COUNT=$((COIN_COUNT + 1))

    log "COIN DETECTED! Pulse #$COIN_COUNT | Value: P$COIN_VALUE"

    # Send coin event to Go API
    curl -s -X POST http://localhost:8080/api/gpio/coin \
        -H "Content-Type: application/json" \
        -d "{\"coin_value\": $COIN_VALUE}" > /dev/null 2>&1 &

    # Update state
    echo "$COIN_COUNT" > "$STATE_FILE"

    # Keep the slot armed for follow-up coins
    extend_armed_window

    # Debounce - wait for pulse to end (coin mechanism takes ~50-100ms)
    sleep 0.15

    # Wait for pin to go HIGH again (pulse ended)
    local timeout=0
    while [ "$(gpio_read "$INTERNAL_GPIO")" = "0" ] && [ $timeout -lt 100 ]; do
        sleep 0.01
        timeout=$((timeout + 1))
    done
}

# ============================================
# ARMED LOOPS
# ============================================
# Edge-triggered wait via libgpiod gpiomon: blocks (zero CPU) until a
# falling edge or until the remaining armed window elapses.
armed_loop_gpiomon() {
    local expires now remaining
    while coinslot_armed; do
        expires=$(cat "$ARMED_FILE" 2>/dev/null | tr -d '[:space:]')
        now=$(date +%s)
        remaining=$((expires - now))
        [ "$remaining" -ge 1 ] || break

        if timeout "$remaining" gpiomon --num-events=1 --falling-edge gpiochip0 "$INTERNAL_GPIO" > /dev/null 2>&1; then
            handle_coin_pulse
        fi
    done
}

# Fallback: fast polling for coin pulses while armed (10ms interval)
armed_loop_poll() {
    local prev_state=1 current_state
    while coinslot_armed; do
        # Read current pin state
        current_state=$(gpio_read "$INTERNAL_GPIO")

        # Detect falling edge (HIGH -> LOW = coin inserted)
        if [ "$prev_state" = "1" ] && [ "$current_state" = "0" ]; then
            handle_coin_pulse
            current_state=1  # handle_coin_pulse waited for pin to return HIGH
        fi

        prev_state=$current_state

        # Small delay to prevent CPU hogging (10ms poll interval)
        sleep 0.01
    done
}

# ============================================
# METHOD: Hardware GPIO (wiringop, raspi-gpio, libgpiod, sysfs)
# ============================================
if [ "$GPIO_METHOD" != "none" ]; then
    log "Using $GPIO_METHOD for GPIO detection"

    # Set pin mode to input with pull-up
    gpio_setup_input "$INTERNAL_GPIO" "up"

    # Initialize state file
    echo "0" > "$STATE_FILE"

    COIN_COUNT=0

    # Prefer edge-triggered waiting when libgpiod's gpiomon is available
    USE_GPIOMON=0
    if [ "$GPIO_METHOD" = "libgpiod" ] && command -v gpiomon &>/dev/null && command -v timeout &>/dev/null; then
        USE_GPIOMON=1
        log "gpiomon available - using edge-triggered waiting while armed"
    fi

    log "Coin slot IDLE - waiting for arm request from portal"

    # Outer state machine: IDLE <-> ARMED
    while true; do
        # IDLE: one cheap file check per second, no GPIO reads at all
        if ! coinslot_armed; then
            sleep 1
            continue
        fi

        # ARMED: actively listen for coin pulses until window closes
        log "Coin slot ARMED - listening for coin pulses"
        if [ "$USE_GPIOMON" = "1" ]; then
            armed_loop_gpiomon
        else
            armed_loop_poll
        fi
        log "Armed window closed - coin slot back to IDLE"
    done

# ============================================
# FALLBACK: File-based test mode (x86 / no GPIO)
# ============================================
# For development/testing on x86 or systems without GPIO
# Simulate coins by writing to the event file:
#   echo '5' > /var/lib/pisowifi/coin_event
else
    log "No GPIO hardware found - running in FILE-BASED TEST MODE"
    log "To simulate a coin: echo '<coin_value>' > $EVENT_FILE"
    log "  Example: echo '5' > $EVENT_FILE  (for P5 coin)"

    COIN_COUNT=0

    while true; do
        # Check if event file has content
        if [ -f "$EVENT_FILE" ]; then
            event_content=$(cat "$EVENT_FILE" 2>/dev/null)
            > "$EVENT_FILE"  # Clear the file

            coin_value=$(echo "$event_content" | awk '{print $1}')

            if [ -n "$coin_value" ] && [ "$coin_value" != "0" ] && [ "$coin_value" -gt 0 ] 2>/dev/null; then
                COIN_COUNT=$((COIN_COUNT + 1))
                log "COIN DETECTED (test mode)! Pulse #$COIN_COUNT | Value: P$coin_value"

                # Send coin event to Go API
                curl -s -X POST http://localhost:8080/api/gpio/coin \
                    -H "Content-Type: application/json" \
                    -d "{\"coin_value\": $coin_value}" > /dev/null 2>&1 &

                # Update state
                echo "$COIN_COUNT" > "$STATE_FILE"
            fi
        fi

        # Poll interval (100ms for responsive test mode)
        sleep 0.1
    done
fi
