#!/bin/bash
# ============================================
# AirCoins PisoWiFi - Service Control Script
# ============================================
# Start/stop/restart/status for all PisoWiFi services
#
# Install to: /usr/local/bin/pisowifi-ctl
# Usage: pisowifi-ctl {start|stop|restart|status|logs}
# ============================================

# ============================================
# CONFIGURATION
# ============================================
WIFI_IFACE="wlan0"
ETH_IFACE="eth0"
PORTAL_IP="192.168.42.1"
WIFI_NET="192.168.42.1/24"

# Central interface/network config (overrides the defaults above if present)
PISOWIFI_CONF="/etc/pisowifi/pisowifi.conf"
[ -f "$PISOWIFI_CONF" ] && source "$PISOWIFI_CONF"

# Config files kept in sync with $WIFI_IFACE at startup
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
DNSMASQ_CONF="/etc/dnsmasq.conf"

# Service binaries
GPIO_LISTENER="/usr/local/bin/gpio-coin-listener"
SESSION_MGR="/usr/local/bin/pisowifi-session-manager"
IPTABLES_RULES="/etc/iptables/pisowifi.rules.sh"

# PID files
GPIO_PID="/var/run/gpio-coin-listener.pid"
SESSION_PID="/var/run/pisowifi-session.pid"

# Log files
LOG_DIR="/var/log/pisowifi"

# ============================================
# COLORS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ============================================
# FUNCTIONS
# ============================================

print_banner() {
    echo -e "${CYAN}"
    echo "  ╔══════════════════════════════════════╗"
    echo "  ║     AirCoins PisoWiFi System         ║"
    echo "  ║     Orange Pi One Control Panel      ║"
    echo "  ╚══════════════════════════════════════╝"
    echo -e "${NC}"
}

# Sync the configured interface into hostapd/dnsmasq so they always match
apply_iface_to_configs() {
    [ -f "$HOSTAPD_CONF" ] && sed -i "s/^interface=.*/interface=$WIFI_IFACE/" "$HOSTAPD_CONF"
    [ -f "$DNSMASQ_CONF" ] && sed -i "s/^interface=.*/interface=$WIFI_IFACE/" "$DNSMASQ_CONF"
}

# Verify the WiFi interface exists before starting the AP/DHCP
check_wifi_iface() {
    if ip link show "$WIFI_IFACE" > /dev/null 2>&1; then
        return 0
    fi
    echo -e "${RED}Interface '$WIFI_IFACE' not found.${NC}"
    echo -e "${YELLOW}Orange Pi PC has no built-in WiFi - plug in a USB WiFi adapter that${NC}"
    echo -e "${YELLOW}supports AP mode, then set WIFI_IFACE in $PISOWIFI_CONF${NC}"
    echo -e "${YELLOW}Available interfaces:${NC}"
    ip -o link | awk -F': ' '{print "    " $2}'
    return 1
}

start_wifi_ap() {
    echo -n "Starting WiFi Access Point... "

    # Configure WiFi interface
    ip link set $WIFI_IFACE up
    ip addr flush dev $WIFI_IFACE
    ip addr add $PORTAL_IP/24 dev $WIFI_IFACE

    # Start hostapd
    systemctl start hostapd 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        # Try manual start
        hostapd -B /etc/hostapd/hostapd.conf 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "${GREEN}[OK]${NC} (manual)"
        else
            echo -e "${RED}[FAIL]${NC}"
            return 1
        fi
    fi
}

start_dhcp() {
    echo -n "Starting DHCP/DNS Server... "
    systemctl start dnsmasq 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        dnsmasq -C /etc/dnsmasq.conf 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "${GREEN}[OK]${NC} (manual)"
        else
            echo -e "${RED}[FAIL]${NC}"
            return 1
        fi
    fi
}

start_webserver() {
    echo -n "Starting Web Server (lighttpd)... "
    systemctl start lighttpd 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        lighttpd -f /etc/lighttpd/lighttpd.conf 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "${GREEN}[OK]${NC} (manual)"
        else
            echo -e "${RED}[FAIL]${NC}"
            return 1
        fi
    fi
}

start_iptables() {
    echo -n "Applying iptables rules... "
    bash "$IPTABLES_RULES" 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "${RED}[FAIL]${NC}"
        return 1
    fi
}

start_gpio_listener() {
    echo -n "Starting GPIO Coin Listener... "
    if [ -f "$GPIO_PID" ] && kill -0 $(cat "$GPIO_PID") 2>/dev/null; then
        echo -e "${YELLOW}[ALREADY RUNNING]${NC}"
        return 0
    fi
    mkdir -p "$LOG_DIR"
    $GPIO_LISTENER &
    sleep 0.5
    if [ -f "$GPIO_PID" ]; then
        echo -e "${GREEN}[OK]${NC} (PID: $(cat $GPIO_PID))"
    else
        echo -e "${RED}[FAIL]${NC}"
        return 1
    fi
}

start_session_manager() {
    echo -n "Starting Session Manager... "
    if [ -f "$SESSION_PID" ] && kill -0 $(cat "$SESSION_PID") 2>/dev/null; then
        echo -e "${YELLOW}[ALREADY RUNNING]${NC}"
        return 0
    fi
    mkdir -p "$LOG_DIR"
    mkdir -p /var/lib/pisowifi/sessions
    $SESSION_MGR &
    sleep 0.5
    if [ -f "$SESSION_PID" ]; then
        echo -e "${GREEN}[OK]${NC} (PID: $(cat $SESSION_PID))"
    else
        echo -e "${RED}[FAIL]${NC}"
        return 1
    fi
}

enable_forwarding() {
    echo -n "Enabling IP forwarding... "
    echo 1 > /proc/sys/net/ipv4/ip_forward
    echo -e "${GREEN}[OK]${NC}"
}

stop_all() {
    echo -e "${YELLOW}Stopping AirCoins PisoWiFi...${NC}"

    echo -n "Stopping GPIO Coin Listener... "
    if [ -f "$GPIO_PID" ]; then
        kill $(cat "$GPIO_PID") 2>/dev/null
        sleep 0.5
        echo -e "${GREEN}[STOPPED]${NC}"
    else
        echo -e "${YELLOW}[NOT RUNNING]${NC}"
    fi

    echo -n "Stopping Session Manager... "
    if [ -f "$SESSION_PID" ]; then
        kill $(cat "$SESSION_PID") 2>/dev/null
        sleep 0.5
        echo -e "${GREEN}[STOPPED]${NC}"
    else
        echo -e "${YELLOW}[NOT RUNNING]${NC}"
    fi

    echo -n "Stopping Web Server... "
    systemctl stop lighttpd 2>/dev/null || killall lighttpd 2>/dev/null
    echo -e "${GREEN}[STOPPED]${NC}"

    echo -n "Stopping DHCP/DNS... "
    systemctl stop dnsmasq 2>/dev/null || killall dnsmasq 2>/dev/null
    echo -e "${GREEN}[STOPPED]${NC}"

    echo -n "Stopping WiFi AP... "
    systemctl stop hostapd 2>/dev/null || killall hostapd 2>/dev/null
    echo -e "${GREEN}[STOPPED]${NC}"

    echo -n "Flushing iptables... "
    iptables -F 2>/dev/null
    iptables -t nat -F 2>/dev/null
    iptables -t mangle -F 2>/dev/null
    iptables -P INPUT ACCEPT 2>/dev/null
    iptables -P FORWARD ACCEPT 2>/dev/null
    echo -e "${GREEN}[FLUSHED]${NC}"
}

show_status() {
    print_banner
    echo -e "${CYAN}--- Service Status ---${NC}"

    # hostapd
    echo -n "  WiFi AP (hostapd):      "
    if pgrep -x hostapd > /dev/null; then
        echo -e "${GREEN}RUNNING${NC}"
    else
        echo -e "${RED}STOPPED${NC}"
    fi

    # dnsmasq
    echo -n "  DHCP/DNS (dnsmasq):     "
    if pgrep -x dnsmasq > /dev/null; then
        echo -e "${GREEN}RUNNING${NC}"
    else
        echo -e "${RED}STOPPED${NC}"
    fi

    # lighttpd
    echo -n "  Web Server (lighttpd):  "
    if pgrep -x lighttpd > /dev/null; then
        echo -e "${GREEN}RUNNING${NC}"
    else
        echo -e "${RED}STOPPED${NC}"
    fi

    # GPIO listener
    echo -n "  GPIO Coin Listener:     "
    if [ -f "$GPIO_PID" ] && kill -0 $(cat "$GPIO_PID") 2>/dev/null; then
        echo -e "${GREEN}RUNNING${NC} (PID: $(cat $GPIO_PID))"
    else
        echo -e "${RED}STOPPED${NC}"
    fi

    # Session manager
    echo -n "  Session Manager:        "
    if [ -f "$SESSION_PID" ] && kill -0 $(cat "$SESSION_PID") 2>/dev/null; then
        echo -e "${GREEN}RUNNING${NC} (PID: $(cat $SESSION_PID))"
    else
        echo -e "${RED}STOPPED${NC}"
    fi

    # WiFi interface
    echo ""
    echo -e "${CYAN}--- Network ---${NC}"
    echo -n "  WiFi Interface ($WIFI_IFACE): "
    if ip link show $WIFI_IFACE > /dev/null 2>&1; then
        local wifi_ip=$(ip addr show $WIFI_IFACE | grep "inet " | awk '{print $2}')
        echo -e "${GREEN}UP${NC} ($wifi_ip)"
    else
        echo -e "${RED}DOWN${NC}"
    fi

    echo -n "  IP Forwarding:          "
    if [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" = "1" ]; then
        echo -e "${GREEN}ENABLED${NC}"
    else
        echo -e "${RED}DISABLED${NC}"
    fi

    # Connected clients
    echo ""
    echo -e "${CYAN}--- Clients ---${NC}"
    local client_count=0
    if [ -f /var/lib/dnsmasq/dnsmasq.leases ]; then
        client_count=$(wc -l < /var/lib/dnsmasq/dnsmasq.leases)
    fi
    echo "  Connected: $client_count"

    # Active sessions
    local active_sessions=$(ls /var/lib/pisowifi/sessions/*.session 2>/dev/null | wc -l)
    echo "  Active Sessions: $active_sessions"

    # Stats
    if [ -f /var/lib/pisowifi/stats ]; then
        echo ""
        echo -e "${CYAN}--- Statistics ---${NC}"
        source /var/lib/pisowifi/stats
        echo "  Total Earnings: ₱${total_earnings:-0}"
        echo "  Total Coins: ${total_coins:-0}"
        echo "  Total Sessions: ${total_sessions:-0}"
    fi
}

show_logs() {
    local lines=${1:-50}
    echo -e "${CYAN}--- Recent Logs (last $lines lines) ---${NC}"
    echo ""
    echo -e "${YELLOW}[GPIO Coin Listener]${NC}"
    tail -n $lines /var/log/pisowifi/gpio-coin.log 2>/dev/null || echo "  No logs yet"
    echo ""
    echo -e "${YELLOW}[Session Manager]${NC}"
    tail -n $lines /var/log/pisowifi/session.log 2>/dev/null || echo "  No logs yet"
}

# ============================================
# MAIN
# ============================================
case "$1" in
    start)
        print_banner
        echo -e "${GREEN}Starting AirCoins PisoWiFi System...${NC}"
        echo ""
        enable_forwarding
        if check_wifi_iface; then
            apply_iface_to_configs
            start_wifi_ap
            start_dhcp
        else
            echo -e "${YELLOW}Skipping WiFi AP and DHCP (no wireless interface).${NC}"
        fi
        start_webserver
        start_iptables
        start_gpio_listener
        start_session_manager
        echo ""
        echo -e "${GREEN}✓ All services started!${NC}"
        echo -e "  Portal: ${CYAN}http://$PORTAL_IP${NC}"
        echo -e "  SSID:   ${CYAN}AirCoins_Free${NC}"
        ;;
    stop)
        stop_all
        echo -e "${GREEN}✓ All services stopped.${NC}"
        ;;
    restart)
        stop_all
        echo ""
        sleep 1
        $0 start
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs "${2:-50}"
        ;;
    *)
        print_banner
        echo "Usage: $0 {start|stop|restart|status|logs}"
        echo ""
        echo "  start   - Start all PisoWiFi services"
        echo "  stop    - Stop all PisoWiFi services"
        echo "  restart - Restart all services"
        echo "  status  - Show service status"
        echo "  logs    - Show recent logs (optional: line count)"
        ;;
esac
