#!/bin/bash
# ============================================
# AirCoins - Session Manager
# ============================================
# Manages client sessions: time tracking,
# coin events processing, and session expiry
#
# Install to: /usr/local/bin/pisowifi-session-manager
# Runs as: systemd service
# ============================================

# ============================================
# CONFIGURATION
# ============================================
ETH_IFACE="eth0"

# Central interface/network config (overrides the defaults above if present)
PISOWIFI_CONF="/etc/pisowifi/pisowifi.conf"
[ -f "$PISOWIFI_CONF" ] && source "$PISOWIFI_CONF"

SESSION_DIR="/var/lib/pisowifi/sessions"
EVENT_FILE="/var/lib/pisowifi/coin_event"
LOG_FILE="/var/log/pisowifi/session.log"
PID_FILE="/var/run/pisowifi-session.pid"
CONFIG_FILE="/var/lib/pisowifi/config"
STATS_FILE="/var/lib/pisowifi/stats"

# Pricing comes from the database only (table `pricing`, managed from the
# admin panel). 1 peso coin = 1 pulse; a pricing row maps the inserted peso
# amount to minutes. There are no hardcoded prices and no rate-per-minute.

# ============================================
# LOGGING
# ============================================
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# ============================================
# CLEANUP
# ============================================
cleanup() {
    log "Session Manager stopping..."
    rm -f "$PID_FILE"
    exit 0
}

trap cleanup SIGTERM SIGINT EXIT

# ============================================
# INIT
# ============================================
echo $$ > "$PID_FILE"
mkdir -p "$SESSION_DIR"
log "Session Manager started (PID: $$)"

# Initialize stats
if [ ! -f "$STATS_FILE" ]; then
    echo "total_earnings=0" > "$STATS_FILE"
    echo "total_coins=0" >> "$STATS_FILE"
    echo "total_sessions=0" >> "$STATS_FILE"
fi

# ============================================
# API-BASED PROCESSING (PostgreSQL-backed via Go API)
# ============================================
# NOTE: these functions MUST be defined before the main loop below,
# otherwise the never-ending loop prevents bash from ever registering them.
API_URL="http://localhost:8080"

# Process unprocessed coin events recorded by the Go API / GPIO listener
process_coin_events() {
    # Get unprocessed coin events
    local events=$(curl -s "$API_URL/api/gpio/coin?unprocessed=true" 2>/dev/null)

    if [ -z "$events" ] || [ "$events" = "null" ]; then
        return
    fi

    # Process each event
    echo "$events" | while read -r event; do
        local coin_value=$(echo "$event" | grep -o '"coin_value":[0-9]*' | cut -d: -f2)
        local event_id=$(echo "$event" | grep -o '"id":[0-9]*' | cut -d: -f2)

        if [ -n "$coin_value" ] && [ "$coin_value" -gt 0 ]; then
            # Resolve minutes from the pricing table (no local defaults)
            local minutes=$(curl -s "$API_URL/api/pricing?coin=$coin_value" | grep -o '"minutes":[0-9]*' | cut -d: -f2 | head -1)

            if [ -z "$minutes" ] || ! [ "$minutes" -gt 0 ] 2>/dev/null; then
                log "ERROR: no pricing tier configured for ₱$coin_value - no time credited. Add the tier in Admin > Pricing."
                # Mark processed so the event isn't retried forever
                curl -s -X POST "$API_URL/api/gpio/coin/$event_id/processed" > /dev/null 2>&1
                continue
            fi

            local seconds=$((minutes * 60))

            log "COIN EVENT: ₱$coin_value = $minutes minutes ($seconds seconds)"

            # Start or extend session via API
            curl -s -X POST "$API_URL/api/session/start" \
                -H "Content-Type: application/json" \
                -d "{\"client_ip\":\"local\",\"seconds\":$seconds,\"coins\":$coin_value}" > /dev/null 2>&1

            log "SESSION: ₱$coin_value | $minutes minutes"

            # Mark event as processed
            curl -s -X POST "$API_URL/api/gpio/coin/$event_id/processed" > /dev/null 2>&1
        fi
    done
}

# Decrement remaining seconds for all active sessions (via API)
tick_sessions() {
    # Get all active sessions
    local sessions=$(curl -s "$API_URL/api/admin/sessions?status=active" 2>/dev/null)

    if [ -z "$sessions" ]; then
        return
    fi

    # Decrement each session
    echo "$sessions" | while read -r session; do
        local session_id=$(echo "$session" | grep -o '"id":[0-9]*' | cut -d: -f2)
        local remaining=$(echo "$session" | grep -o '"remaining_seconds":[0-9]*' | cut -d: -f2)

        if [ -n "$session_id" ] && [ -n "$remaining" ] && [ "$remaining" -gt 0 ]; then
            # Decrement via API
            curl -s -X POST "$API_URL/api/session/tick" \
                -H "Content-Type: application/json" \
                -d "{\"session_id\":$session_id}" > /dev/null 2>&1
        fi
    done
}

# Expire sessions (via API)
check_sessions() {
    # Get expired sessions
    local expired=$(curl -s "$API_URL/api/admin/sessions?status=expired" 2>/dev/null)

    if [ -z "$expired" ]; then
        return
    fi

    # Log each expired session
    echo "$expired" | while read -r session; do
        local session_id=$(echo "$session" | grep -o '"id":[0-9]*' | cut -d: -f2)

        if [ -n "$session_id" ]; then
            log "SESSION EXPIRED: session_id=$session_id"
        fi
    done
}

# ============================================
# MAIN LOOP
# ============================================
log "Entering main loop (1-second tick)"

while true; do
    # Process unprocessed coin events from database
    process_coin_events

    # Tick all active sessions (decrement 1 second via API)
    tick_sessions

    # Check for expired sessions
    check_sessions

    # Sleep 1 second
    sleep 1
done

# NOTE: process_coin_events / tick_sessions / check_sessions are defined
# above, before the main loop (see "API-BASED PROCESSING" section).
